{
  "buildCommand": "find node_modules -path '*/caniuse-lite/package.json' -print -exec grep '\"version\"' {} \\; ; npm ls caniuse-lite --all || true; env -u npm_config_cache_dir npm run build:css",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/jobs/:id",
      "destination": "/api/job?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "nutrition-3.vercel.app"
        }
      ],
      "destination": "https://diet-planner-eg.vercel.app/:path*",
      "statusCode": 301
    }
  ],
  "installCommand": "env -u npm_config_cache_dir npm install --no-audit --no-fund"
}
